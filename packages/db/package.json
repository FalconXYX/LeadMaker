{
  "name": "@leadmaker/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "pull": "prisma db pull && node scripts/postpull.mjs && prisma format && prisma generate",
