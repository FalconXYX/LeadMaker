  location                Unsupported("geography")? @default(dbgenerated("(st_setsrid(st_makepoint(longitude, latitude), 4326))::geography"))
  county_fips             String?                   @db.Char(5)
  rating                  Float?
  review_count            Int                       @default(0)
  profile_url             String?
  image_url               String?
  tier                    String?                   @db.VarChar(32)
  tier_rank               Int                       @default(0)
  certifications          Json                      @default("[]")
  designation_codes       Json                      @default("[]")
  specialties             Json                      @default("[]")
  presidents_club_stars   Int                       @default(0)
  gaf_leads_enrolled      Boolean                   @default(false)
  google_place_id         String?                   @db.VarChar(128)
  description             String?
  in_business_since       Int?
  employees_range         String?                   @db.VarChar(64)
  distinctions            Json                      @default("[]")
  profile_details         Json                      @default("{}")
  profile_scraped_at      DateTime?                 @db.Timestamptz(6)
  profile_error           String?
  raw                     Json                      @default("{}")
  scraped_attributes      Json                      @default("{}")
  system_tags             Json                      @default("[]")
  segment                 String?                   @db.VarChar(20)
  priority_score          Decimal?                  @db.Decimal(4, 1)
  tagged_at               DateTime?                 @db.Timestamptz(6)
  assigned_rep_id         String?                   @db.Uuid
  account_status          String                    @default("prospect") @db.VarChar(30)
  custom_fields           Json                      @default("{}")
  updated_in_last_poll    Boolean                   @default(true)
  last_material_change_at DateTime?                 @db.Timestamptz(6)
  team_last_checked_at    DateTime?                 @db.Timestamptz(6)
  team_last_serviced_at   DateTime?                 @db.Timestamptz(6)
  content_hash            String                    @db.VarChar(64)
  first_seen_at           DateTime                  @default(now()) @db.Timestamptz(6)
  last_seen_at            DateTime                  @default(now()) @db.Timestamptz(6)
  listing_updated_at      DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  version                 Int                       @default(1)
  founded_year            Int?                      @default(dbgenerated("COALESCE(\nCASE\n    WHEN ((scraped_attributes ->> 'founded_year'::text) ~ '^[0-9]{4}$'::text) THEN ((scraped_attributes ->> 'founded_year'::text))::integer\n    ELSE NULL::integer\nEND, (\"substring\"((jsonb_path_query_first(system_tags, '$[*]?(@.\"key\" == \"maturity\").\"reason\"'::jsonpath) #>> '{}'::text[]), 'since ([0-9]{4})'::text))::integer, in_business_since)"))
  tag_facets              String[]                  @default(dbgenerated("system_tag_facets(system_tags)"))
  sales_stage             String                    @default("new") @db.VarChar(20)
  stage_changed_at        DateTime?                 @db.Timestamptz(6)
  last_contacted_at       DateTime?                 @db.Timestamptz(6)
  accounts                accounts[]
  activity_logs           activity_logs[]
  users                   users?                    @relation(fields: [assigned_rep_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company_custom_tags     company_custom_tags[]
  company_insights        company_insights[]
  company_source_ids      company_source_ids[]
  contacts                contacts[]
  enrichments             enrichments[]
  field_overrides         field_overrides[]
  lead_allocations        lead_allocations[]
  lead_rep_state          lead_rep_state[]
  notifications           notifications[]
  reviews                 reviews[]
  search_hits             search_hits[]
  tasks                   tasks[]

  @@index([assigned_rep_id, priority_score(sort: Desc), id(sort: Desc)], map: "companies_assigned_rep_priority_idx")
  @@index([business_name(ops: raw("gin_trgm_ops"))], map: "companies_business_name_trgm", type: Gin)
  @@index([county_fips])
  @@index([custom_fields(ops: JsonbPathOps)], map: "companies_custom_fields_gin", type: Gin)
  @@index([location], map: "companies_location_gist", type: Gist)
  @@index([postal_code])
  @@index([priority_score(sort: Desc), id(sort: Desc)], map: "companies_priority_idx")
  @@index([state, city])
  @@index([system_tags(ops: JsonbPathOps)], map: "companies_system_tags_gin", type: Gin)
  @@index([founded_year(sort: Desc), id(sort: Desc)], map: "companies_founded_year_desc_idx")
  @@index([founded_year, id], map: "companies_founded_year_idx")
  @@index([tag_facets], map: "companies_tag_facets_gin", type: Gin)
  @@index([tag_facets], map: "companies_tag_facets_pool_gin", type: Gin, where: raw("(assigned_rep_id IS NULL)"))
  @@index([assigned_rep_id, sales_stage, account_status, segment, last_contacted_at, updated_in_last_poll, stage_changed_at], map: "companies_rep_sales_cover_idx")
  @@index([assigned_rep_id, id], map: "companies_site_email_idx", where: raw("(tag_facets @> '{direct_email}'::text[])"))
  @@index([assigned_rep_id, id], map: "companies_target_named_idx", where: raw("((tag_facets @> '{decision_maker=identified}'::text[]) OR ((tag_facets @> '{decision_maker=weak}'::text[]) AND (system_tags @> '[{\"key\": \"target_contact\", \"contact\": {\"named\": true}}]'::jsonb)))"))
}

