  @@index([company_id, created_at(sort: Desc)], map: "activity_logs_company_idx")
  @@index([user_id, created_at(sort: Desc)], map: "activity_logs_user_idx")
  @@index([created_at], map: "activity_logs_created_brin", type: Brin)
