// Generated by `npm run db:pull` (prisma db pull + scripts/postpull.mjs) from the dbmate-migrated
// database. Change db/migrations, then re-pull; never edit models by hand.
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "esm"
  runtime         = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model accounts {
  account_id       String     @id @db.VarChar(64)
  name             String     @db.VarChar(255)
  phone            String?    @db.VarChar(64)
  postal_code      String?    @db.VarChar(16)
  city             String?    @db.VarChar(128)
  state            String?    @db.VarChar(8)
  status           String?    @db.VarChar(32)
  owner_rep        String?    @db.VarChar(128)
  annual_spend     Float?
  last_order_at    DateTime?  @db.Timestamptz(6)
  extra            Json       @default("{}")
  company_id       String?    @db.Uuid
  match_confidence Float?
  match_method     String?    @db.VarChar(32)
  imported_at      DateTime   @default(now()) @db.Timestamptz(6)
  companies        companies? @relation(fields: [company_id], references: [id], onUpdate: NoAction)

  @@index([company_id], map: "accounts_company_idx")
}

