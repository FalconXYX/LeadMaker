{
  "name": "@leadmaker/assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "TEST_REDIS_URL=${TEST_REDIS_URL:-redis://localhost:56379/9} vitest run"
  },
  "dependencies": {
    "@leadmaker/shared": "^0.1.0",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  }
}
