# Copy to .env. docker compose reads it for substitution; every value has a working local default,
# so an empty .env runs the demo. Values below are those defaults.

# --- Postgres (PostGIS) and Redis --------------------------------------------------------------
POSTGRES_USER=leadmaker
POSTGRES_PASSWORD=leadmaker
POSTGRES_HOST_PORT=55432
# Multi-arch PostGIS build; postgis/postgis:16-3.4 is the official (amd64-only) equivalent.
POSTGIS_IMAGE=imresamu/postgis:16-3.4
REDIS_HOST_PORT=56379

# Node services and Prisma, when run on the host (inside compose they use postgres:5432 / redis:6379).
# The app database is always named 'leadmaker'; tests use 'leadmaker_test' (npm run db:test:reset).
DATABASE_URL=postgres://leadmaker:leadmaker@localhost:55432/leadmaker
# Read replica the query service reads from (same form); empty = the primary. Inside compose, query uses
# postgres-replica; from the host it is localhost:55433.
DATABASE_REPLICA_URL=
# Password of the 'replicator' role the replica streams with (created on first init by db/init/20-replication.sh).
REPLICATION_PASSWORD=replicator
REPLICA_HOST_PORT=55433
DATABASE_POOL_MAX=10
TEST_DATABASE_URL=postgres://leadmaker:leadmaker@localhost:55432/leadmaker_test
REDIS_URL=redis://localhost:56379
# db/seed: leads allocated to each demo rep, and whether to give them demo sales history (stages, calls, tasks; 0 = off).
SEED_LEADS_PER_REP=50
SEED_DEMO_ACTIVITY=1
# Section 1 SQLite file the compose 'import' service loads: its directory (mounted read-only) and name.
SECTION1_DIR=./data
SECTION1_DB_FILE=leadmaker.db

# --- Services ---------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
# Gateway signs HS256 JWTs with this and forwards INTERNAL_TOKEN as X-Internal-Token; internal
# services reject requests without it. Use long random values outside local demos.
JWT_SECRET=dev-jwt-secret-change-me
JWT_TTL=12h
INTERNAL_TOKEN=dev-internal-token-change-me
# 1 enables POST /auth/dev-login {email} for the seeded demo users. Never enable in production.
DEMO_MODE=1
# Each service listens on PORT; these are the contract ports (only the gateway is published).
GATEWAY_HOST_PORT=8080
# Host interface the gateway is published on; 0.0.0.0 shares it on the LAN (anyone can then use dev-login).
GATEWAY_BIND=127.0.0.1
QUERY_URL=http://localhost:8081
# Web app (compose profile app): host port and interface of its nginx, which proxies /api and /auth to the gateway.
WEB_HOST_PORT=3000
WEB_BIND=127.0.0.1
# Map tiles baked into the web build: an XYZ URL template (empty = the app's default) and its attribution.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
CRM_WRITE_URL=http://localhost:8082
NOTIFIER_URL=http://localhost:8084
# crm-write: most leads one allocation (POST /api/allocations, /by-filter) may move, and one bulk tag request may tag.
# The gateway reports both (and LEADMAKER_USER_JOBS_PER_HOUR) on GET /api/config. Bulk unallocation takes at most
# 500, or MAX_BULK_ALLOCATION when lower.
MAX_BULK_ALLOCATION=5000
MAX_BULK_TAG=500
# Calls, emails and visits each rep should log per week (the dashboard's activity goal; GET /api/config).
WEEKLY_ACTIVITY_GOAL=25
# Gateway per-user token bucket (Redis): refill rate and bucket size.
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=40
# Gateway: ms before a proxied request to query/crm-write fails with 504.
UPSTREAM_TIMEOUT_MS=5000
# Gateway: seconds a user's role is cached, i.e. the longest a demoted or deleted user keeps their access.
USER_ROLE_TTL_SECONDS=30
# Gateway: ms between role re-checks on an open event stream (SSE).
SSE_ROLE_CHECK_MS=10000
# Query service: TTL of cached lead-list pages.
LEAD_LIST_CACHE_TTL_SECONDS=60
# Query service: Postgres connections reserved for searches (per database), separate from DATABASE_POOL_MAX.
DATABASE_SEARCH_POOL_MAX=8
# Query service: searches running at once (at most DATABASE_SEARCH_POOL_MAX).
SEARCH_CONCURRENCY=8
# Query service: searches waiting for a slot before more are shed with 503 + Retry-After (default 4x the search pool).
SEARCH_QUEUE_MAX=32
# Query service: longest a search waits for a slot before it is shed with 503.
SEARCH_QUEUE_WAIT_MS=1000
# Query service: statement_timeout of searches; per connection here, a per-role setting behind PgBouncer.
SEARCH_STATEMENT_TIMEOUT_MS=2000
# Query service: statement_timeout of every other read (profile, KPIs, users, suggestions).
STATEMENT_TIMEOUT_MS=1000
# Query service: longest one Redis command may take before the cache is skipped for a moment.
REDIS_COMMAND_TIMEOUT_MS=250
# Relay: team_dashboard_kpis refresh period; also refreshed KPI_REFRESH_DEBOUNCE_MS after the first of a burst
# of allocation, state, activity and pipeline.run_completed events.
KPI_REFRESH_INTERVAL_MS=300000
KPI_REFRESH_DEBOUNCE_MS=2000
# Relay: the shared list-cache versions (all leads, the pool) move at most once per this many ms under a burst of
# changes, with a trailing bump for the last one; each rep's own version moves at once. 0 = no coalescing.
LIST_VERSION_COALESCE_MS=1000

# --- Python pipeline (leadmaker/; all optional) -----------------------------------------------
# The pipeline's SQLAlchemy URL on the host (it ignores the Prisma-form DATABASE_URL; the compose worker sets its own).
LEADMAKER_DATABASE_URL=postgresql+psycopg://leadmaker:leadmaker@localhost:55432/leadmaker
# Seconds between job-queue polls of the compose worker when idle.
WORKER_POLL_SECONDS=5
# Refresh requests (crm-write POST /api/refresh and `leadmaker jobs enqueue --requested-by`) per user per hour.
LEADMAKER_USER_JOBS_PER_HOUR=20
LEADMAKER_CONTACT=
LEADMAKER_CACHE_DIR=
LEADMAKER_CONCURRENCY=
LEADMAKER_HOST_INTERVAL=
LEADMAKER_PROFILE_TTL_HOURS=
LEADMAKER_ENRICHMENT_TTL_HOURS=
LEADMAKER_BBB_INDEX_TTL_HOURS=
LEADMAKER_TAG_RULES=
LEADMAKER_EXTRACTION_SLOTS=
LEADMAKER_LLM_PROVIDER=
LEADMAKER_LLM_MODEL=
LEADMAKER_LLM_BASE_URL=
LEADMAKER_LLM_API_KEY=
LEADMAKER_LLM_RPM=
LEADMAKER_LLM_RPD=
LEADMAKER_LLM_USAGE_FILE=
# Section 4 AI. Free-tier quotas are per model (gemini-3.8-flash: 20 requests/day). Gemini defaults: the worker and
# the assistant run on gemini-3.5-flash-lite; the assistant falls back to gemini-3.8-flash:20 ("none" = no fallback).
# Keep the worker's model stable: insight hashes include it.
LEADMAKER_WORKER_LLM_MODEL=
LEADMAKER_WORKER_LLM_RPD=
LEADMAKER_ASSISTANT_LLM_PROVIDER=
LEADMAKER_ASSISTANT_LLM_MODEL=
LEADMAKER_ASSISTANT_RPM=
LEADMAKER_ASSISTANT_RPD=
LEADMAKER_ASSISTANT_FALLBACK_MODELS=
ASSISTANT_USER_LLM_CALLS_PER_DAY=
LEADMAKER_INSIGHTS_ON_EDIT=
LEADMAKER_INSIGHTS_EDIT_DELAY_SECONDS=
ASSISTANT_PROVIDER_TIMEOUT_MS=
ASSISTANT_REQUEST_TIMEOUT_MS=
LEADMAKER_INSIGHTS_BATCH_SIZE=
LEADMAKER_INSIGHTS_ON_REFRESH=
LEADMAKER_AI_SCHEDULES=
LEADMAKER_BRIEFING_AI=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
SOCRATA_APP_TOKEN=
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=
